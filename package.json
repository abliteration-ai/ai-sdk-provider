{
  "name": "@abliterationai/ai-sdk-provider",
  "version": "0.1.0",
  "description": "Abliteration.ai provider for the Vercel AI SDK.",
  "license": "Apache-2.0",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist/**/*",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup",
    "clean": "rm -rf dist",
    "dev": "tsup --watch",
    "format": "biome format --write .",
    "lint": "biome check .",
    "prepublishOnly": "npm run lint && npm run typecheck && npm test && npm run build",
    "publish:public": "npm publish --access public --provenance",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^3.0.0",
    "@ai-sdk/openai": "^3.0.0"
  },
  "peerDependencies": {
    "ai": "^6.0.0",
    "zod": "^3.25.0 || ^4.0.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.3.7",
    "@types/node": "^24.2.0",
    "ai": "^6.0.0",
    "tsup": "^8.5.0",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4",
    "zod": "^4.0.0"
  },
  "engines": {
    "node": ">=18"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "homepage": "https://docs.abliteration.ai/integrations/vercel-ai-sdk",
  "repository": {
    "type": "git",
    "url": "git+ssh://git@github.com/abliteration-ai/ai-sdk-provider.git"
  },
  "bugs": {
    "url": "https://github.com/abliteration-ai/ai-sdk-provider/issues"
  },
  "keywords": [
    "ai",
    "ai-sdk",
    "abliteration",
    "abliteration.ai",
    "vercel-ai-sdk"
  ]
}
